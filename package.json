{
	"name": "@sv/cnblocks",
	"version": "0.5.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"build:blocks": "pnpm shadcn-svelte registry build ./registry.json -o ./static/r",
		"build:mist": "pnpm shadcn-svelte registry build ./mist-registry.json -o ./static/m",
		"build:veil": "pnpm shadcn-svelte registry build ./veil-registry.json -o ./static/v"
	},
	"devDependencies": {
		"@internationalized/date": "^3.10.1",
		"@lucide/svelte": "^1.55.0",
		"@shikijs/langs": "^4.0.2",
		"@shikijs/themes": "^4.0.2",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.0.7",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"dotted-map": "^3.1.0",
		"mode-watcher": "^1.0.6",
		"paneforge": "^0.0.6",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shiki": "^4.0.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"svelte-meta-tags": "^5.0.3",
		"swiper": "^12.1.3",
		"tailwind-merge": "^3.3.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.8",
		"typescript": "^6.0.2",
		"velite": "^0.3.1",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.2.10",
		"@fontsource-variable/geist": "^5.2.9",
		"@fontsource-variable/geist-mono": "^5.2.8",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/sora": "^5.2.8",
		"@fontsource/asar": "^5.2.8",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"dompurify": "^3.3.0",
		"isomorphic-dompurify": "^3.0.0",
		"marked": "^18.0.0",
		"package-manager-detector": "^1.6.0",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.7.0",
		"svelte-toolbelt": "^0.10.6",
		"tw-animate-css": "^1.4.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
