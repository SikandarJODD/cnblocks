			"content": "<script lang=\"ts\">\n\timport Button from \"#lib/components/ui/dusk/button/button.svelte\";\n\timport Activity from \"@lucide/svelte/icons/activity\";\n\timport ArrowRightLeft from \"@lucide/svelte/icons/arrow-right-left\";\n\timport ArrowUp from \"@lucide/svelte/icons/arrow-up\";\n\timport Bell from \"@lucide/svelte/icons/bell\";\n\timport Calendar from \"@lucide/svelte/icons/calendar\";\n\timport ChevronDown from \"@lucide/svelte/icons/chevron-down\";\n\timport Clock from \"@lucide/svelte/icons/clock\";\n\timport CloudDownload from \"@lucide/svelte/icons/cloud-download\";\n\timport HardDriveDownload from \"@lucide/svelte/icons/hard-drive-download\";\n\timport History from \"@lucide/svelte/icons/history\";\n\timport Link2 from \"@lucide/svelte/icons/link-2\";\n\timport ListChecks from \"@lucide/svelte/icons/list-checks\";\n\timport Mail from \"@lucide/svelte/icons/mail\";\n\timport Mic2 from \"@lucide/svelte/icons/mic-2\";\n\timport MonitorDown from \"@lucide/svelte/icons/monitor-down\";\n\timport Plug from \"@lucide/svelte/icons/plug\";\n\timport Plus from \"@lucide/svelte/icons/plus\";\n\timport Users from \"@lucide/svelte/icons/users\";\n\timport Zap from \"@lucide/svelte/icons/zap\";\n\timport { onMount, type Component } from \"svelte\";\n\n\tconst features = [\n\t\t{ id: \"workflow-agents\", label: \"Workflow agents\" },\n\t\t{ id: \"alerts\", label: \"Alerts\" },\n\t\t{ id: \"timeline\", label: \"Timeline\" },\n\t\t{ id: \"integrations\", label: \"Integrations\" },\n\t] as const;\n\n\ttype FeatureId = (typeof features)[number][\"id\"];\n\ttype Highlight = { icon: Component<{ class?: string }>; label: string };\n\n\tconst featureHighlights: Record<FeatureId, Highlight[]> = {\n\t\t\"workflow-agents\": [\n\t\t\t{ icon: ArrowRightLeft, label: \"Automated handoff routing\" },\n\t\t\t{ icon: ListChecks, label: \"Account playbooks\" },\n\t\t\t{ icon: Zap, label: \"Follow-up task agents\" },\n\t\t],\n\t\talerts: [\n\t\t\t{ icon: Bell, label: \"Renewal reminders\" },\n\t\t\t{ icon: Clock, label: \"Stalled deal signals\" },\n\t\t\t{ icon: Activity, label: \"Quiet account alerts\" },\n\t\t],\n\t\ttimeline: [\n\t\t\t{ icon: History, label: \"Full activity history\" },\n\t\t\t{ icon: Users, label: \"Team-visible notes\" },\n\t\t\t{ icon: Mail, label: \"Cross-channel threads\" },\n\t\t],\n\t\tintegrations: [\n\t\t\t{ icon: Plug, label: \"Gmail and Outlook sync\" },\n\t\t\t{ icon: Calendar, label: \"Calendar availability\" },\n\t\t\t{ icon: Link2, label: \"Billing and Stripe data\" },\n\t\t],\n\t};\n\n\tconst profileImage =\n\t\t\"https://images.unsplash.com/photo-1782366951390-d6798e902db7?q=80&w=1015&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\";\n\tlet activeId: FeatureId = $state(\"workflow-agents\");\n\n\tfunction scrollToFeature(id: FeatureId) {\n\t\tdocument.getElementById(id)?.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n\t\tactiveId = id;\n\t}\n\n\tonMount(() => {\n\t\tconst sections = features\n\t\t\t.map(({ id }) => document.getElementById(id))\n\t\t\t.filter((section): section is HTMLElement => section !== null);\n\t\tconst observer = new IntersectionObserver(\n\t\t\t(entries) => {\n\t\t\t\tconst visible = entries\n\t\t\t\t\t.filter((entry) => entry.isIntersecting)\n\t\t\t\t\t.sort((a, b) => b.intersectionRatio - a.intersectionRatio);\n\t\t\t\tconst nextId = visible[0]?.target.id as FeatureId | undefined;\n\t\t\t\tif (nextId) activeId = nextId;\n\t\t\t},\n\t\t\t{ rootMargin: \"-25% 0px -55% 0px\", threshold: [0.15, 0.35, 0.55, 0.75] }\n\t\t);\n\t\tsections.forEach((section) => observer.observe(section));\n\t\treturn () => observer.disconnect();\n\t});\n</script>\n\n<section class=\"py-16 md:py-20\">\n\t<div class=\"mx-auto max-w-7xl px-6\">\n\t\t<h2\n\t\t\tclass=\"max-w-4xl text-4xl font-medium tracking-tight text-balance text-muted-foreground\"\n\t\t>\n\t\t\t<span class=\"text-foreground\">Built for the full workflow.</span><br /> One connected revenue\n\t\t\tproduct.\n\t\t</h2>\n\t\t<div class=\"mt-16 grid gap-6 md:mt-32 lg:grid-cols-[auto_1fr]\">\n\t\t\t<div class=\"sticky top-24 h-fit w-56 max-lg:hidden\">\n\t\t\t\t<div class=\"text-sm text-muted-foreground\">Product</div>\n\t\t\t\t<div class=\"mt-4 -ml-4 flex flex-col *:justify-start\">\n\t\t\t\t\t{#each features as feature (feature.id)}\n\t\t\t\t\t\t<Button\n\t\t\t\t\t\t\ttype=\"button\"\n\t\t\t\t\t\t\tvariant=\"ghost\"\n\t\t\t\t\t\t\tdata-state={activeId === feature.id ? \"active\" : undefined}\n\t\t\t\t\t\t\tonclick={() => scrollToFeature(feature.id)}\n\t\t\t\t\t\t\tclass=\"not-data-[state=active]:text-muted-foreground hover:bg-transparent\"\n\t\t\t\t\t\t\t>{feature.label}</Button\n\t\t\t\t\t\t>\n\t\t\t\t\t{/each}\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"flex flex-col gap-16 md:gap-32\">\n\t\t\t\t<div\n\t\t\t\t\tid=\"workflow-agents\"\n\t\t\t\t\tclass=\"grid scroll-mt-32 gap-6 sm:grid-cols-2 md:grid-cols-5 lg:gap-12\"\n\t\t\t\t>\n\t\t\t\t\t{@render FeatureCopy(\n\t\t\t\t\t\t\"Workflow agents\",\n\t\t\t\t\t\t\"Seamless handoffs.\",\n\t\t\t\t\t\t\"Email, chat, and support history stay on the account so nobody works from memory.\",\n\t\t\t\t\t\tfeatureHighlights[\"workflow-agents\"]\n\t\t\t\t\t)}\n\t\t\t\t\t<div\n\t\t\t\t\t\tclass=\"relative flex aspect-square rounded-3xl border border-border/50 bg-foreground/2 p-3 md:col-span-3\"\n\t\t\t\t\t>\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\tclass=\"relative m-auto aspect-76/59 max-w-sm rounded-2xl bg-linear-to-b from-zinc-300 to-transparent p-px dark:from-zinc-700\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t<img\n\t\t\t\t\t\t\t\tsrc=\"/payments-light.png\"\n\t\t\t\t\t\t\t\tclass=\"rounded-[15px] dark:hidden\"\n\t\t\t\t\t\t\t\talt=\"Payments dashboard\"\n\t\t\t\t\t\t\t\twidth=\"1207\"\n\t\t\t\t\t\t\t\theight=\"929\"\n\t\t\t\t\t\t\t\tloading=\"lazy\"\n\t\t\t\t\t\t\t\tdecoding=\"async\"\n\t\t\t\t\t\t\t/><img\n\t\t\t\t\t\t\t\tsrc=\"/payments.png\"\n\t\t\t\t\t\t\t\tclass=\"hidden rounded-[15px] dark:block\"\n\t\t\t\t\t\t\t\talt=\"Payments dashboard\"\n\t\t\t\t\t\t\t\twidth=\"1207\"\n\t\t\t\t\t\t\t\theight=\"929\"\n\t\t\t\t\t\t\t\tloading=\"lazy\"\n\t\t\t\t\t\t\t\tdecoding=\"async\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t<div\n\t\t\t\t\tid=\"alerts\"\n\t\t\t\t\tclass=\"grid scroll-mt-32 gap-6 sm:grid-cols-2 md:grid-cols-5 lg:gap-12\"\n\t\t\t\t>\n\t\t\t\t\t{@render FeatureCopy(\n\t\t\t\t\t\t\"Alerts\",\n\t\t\t\t\t\t\"Proactive alerts.\",\n\t\t\t\t\t\t\"Surface renewals, quiet accounts, and stalled deals before they slip past quarter end.\",\n\t\t\t\t\t\tfeatureHighlights.alerts\n\t\t\t\t\t)}\n\t\t\t\t\t<div\n\t\t\t\t\t\tclass=\"relative flex aspect-square rounded-3xl border border-border/50 bg-foreground/2 p-3 md:col-span-3\"\n\t\t\t\t\t>\n\t\t\t\t\t\t{@render AIInputIllustration()}\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t<div\n\t\t\t\t\tid=\"timeline\"\n\t\t\t\t\tclass=\"grid scroll-mt-32 gap-6 sm:grid-cols-2 md:grid-cols-5 lg:gap-12\"\n\t\t\t\t>\n\t\t\t\t\t{@render FeatureCopy(\n\t\t\t\t\t\t\"Timeline\",\n\t\t\t\t\t\t\"Shared timeline.\",\n\t\t\t\t\t\t\"Sales, success, and support work from one account view so every handoff keeps context.\",\n\t\t\t\t\t\tfeatureHighlights.timeline\n\t\t\t\t\t)}\n\t\t\t\t\t<div\n\t\t\t\t\t\tclass=\"relative flex aspect-square rounded-3xl border border-border/50 bg-foreground/2 p-3 md:col-span-3\"\n\t\t\t\t\t>\n\t\t\t\t\t\t{@render DynamicIslandIllustration()}\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t<div\n\t\t\t\t\tid=\"integrations\"\n\t\t\t\t\tclass=\"grid scroll-mt-32 gap-6 sm:grid-cols-2 md:grid-cols-5 lg:gap-12\"\n\t\t\t\t>\n\t\t\t\t\t{@render FeatureCopy(\n\t\t\t\t\t\t\"Integrations\",\n\t\t\t\t\t\t\"Connected stack.\",\n\t\t\t\t\t\t\"Sync email, calendar, and billing tools so customer data stays current across your workflow.\",\n\t\t\t\t\t\tfeatureHighlights.integrations\n\t\t\t\t\t)}\n\t\t\t\t\t<div\n\t\t\t\t\t\tclass=\"relative flex aspect-square rounded-3xl border border-border/50 bg-zinc-100 p-3 md:col-span-3\"\n\t\t\t\t\t>\n\t\t\t\t\t\t{@render DownloadIllustration()}\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>\n\n{#snippet FeatureCopy(title: string, lead: string, copy: string, items: Highlight[])}\n\t<div class=\"flex flex-col justify-between pb-4 md:col-span-2\">\n\t\t<div class=\"md:pr-6 lg:pr-0\">\n\t\t\t<h3 class=\"mb-6 text-sm font-medium text-muted-foreground\">{title}</h3>\n\t\t\t<p class=\"text-lg font-medium text-balance text-muted-foreground\">\n\t\t\t\t<span class=\"text-foreground\">{lead}</span>\n\t\t\t\t{copy}\n\t\t\t</p>\n\t\t</div>\n\t\t<ul class=\"mt-8 divide-y text-muted-foreground *:flex *:items-center *:gap-3 *:py-3\">\n\t\t\t{#each items as item (item.label)}{@const Icon = item.icon}\n\t\t\t\t<li><Icon class=\"size-4\" />{item.label}</li>{/each}\n\t\t</ul>\n\t</div>\n{/snippet}\n\n{#snippet DownloadIllustration()}\n\t<div class=\"absolute inset-0 z-1 m-auto size-fit scale-95\">\n\t\t<Button\n\t\t\tvariant=\"secondary\"\n\t\t\tclass=\"ml-1 bg-background/25 inset-ring inset-ring-foreground/25 backdrop-blur\"\n\t\t\tsize=\"sm\"\n\t\t\t><HardDriveDownload class=\"opacity-75\" /><span class=\"border-r pr-2\">Download</span\n\t\t\t><ChevronDown class=\"opacity-50\" /></Button\n\t\t>\n\t\t<div\n\t\t\tclass=\"mt-3 min-w-52 rounded-2xl bg-white p-1 shadow-xl ring shadow-black/6.5 ring-black/6.5 *:cursor-pointer\"\n\t\t>\n\t\t\t<div class=\"peer flex gap-2 rounded-xl px-3 py-1.5 hover:bg-black/5\">\n\t\t\t\t<MonitorDown class=\"size-4 translate-y-0.5 text-black\" />\n\t\t\t\t<div>\n\t\t\t\t\t<div class=\"text-xs font-medium text-black\">Computer</div>\n\t\t\t\t\t<div class=\"text-xs text-black/50\">16.1MB left</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"flex gap-2 rounded-xl px-3 py-1.5 not-peer-hover:bg-black/5\">\n\t\t\t\t<CloudDownload class=\"size-4 translate-y-0.5 text-black\" />\n\t\t\t\t<div>\n\t\t\t\t\t<div class=\"text-xs font-medium text-black\">Cloud</div>\n\t\t\t\t\t<div class=\"text-xs text-black/50\">Unlimited</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n{/snippet}\n\n{#snippet AIInputIllustration()}\n\t<div aria-hidden=\"true\" class=\"absolute inset-8 z-1 m-auto h-fit max-w-sm scale-95\">\n\t\t<div\n\t\t\tclass=\"mt-auto h-fit rounded-3xl bg-card p-3 shadow-xl ring shadow-black/15 ring-foreground/15\"\n\t\t>\n\t\t\t<div class=\"p-2 pb-3 text-sm text-muted-foreground\">Ask Tailark what you need...</div>\n\t\t\t<div class=\"flex justify-between\">\n\t\t\t\t<div class=\"flex gap-1\">\n\t\t\t\t\t<div class=\"flex size-7 rounded-full *:m-auto *:size-4 hover:bg-muted\">\n\t\t\t\t\t\t<Plus />\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"flex size-7 rounded-full *:m-auto *:size-4 hover:bg-muted\">\n\t\t\t\t\t\t<Mic2 />\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div\n\t\t\t\t\tclass=\"flex size-7 rounded-full bg-foreground text-background *:m-auto *:size-4\"\n\t\t\t\t>\n\t\t\t\t\t<ArrowUp />\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n{/snippet}\n\n{#snippet DynamicIslandIllustration()}\n\t<div\n\t\taria-hidden=\"true\"\n\t\tclass=\"absolute inset-x-8 bottom-0 z-1 mx-auto mt-auto h-2/3 w-10/12 max-w-96 origin-bottom scale-95 rounded-t-[4rem] border border-border/50 mask-b-from-background px-4 pt-4\"\n\t>\n\t\t<div\n\t\t\tclass=\"h-full overflow-hidden rounded-t-[3rem] bg-foreground/2 p-3 shadow-lg ring shadow-black/15 ring-foreground/10\"\n\t\t>\n\t\t\t<div\n\t\t\t\tclass=\"relative rounded-[2.25rem] bg-card p-2 shadow-xl ring shadow-black/6.5 ring-foreground/10\"\n\t\t\t>\n\t\t\t\t<div class=\"flex gap-2\">\n\t\t\t\t\t<div\n\t\t\t\t\t\tclass=\"relative size-18 overflow-hidden rounded-[1.75rem] shadow-md before:absolute before:inset-0 before:rounded-[1.75rem] before:border before:border-black/20\"\n\t\t\t\t\t>\n\t\t\t\t\t\t<img\n\t\t\t\t\t\t\tsrc={profileImage}\n\t\t\t\t\t\t\talt=\"\"\n\t\t\t\t\t\t\twidth=\"136\"\n\t\t\t\t\t\t\theight=\"136\"\n\t\t\t\t\t\t\tloading=\"lazy\"\n\t\t\t\t\t\t\tdecoding=\"async\"\n\t\t\t\t\t\t/>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"py-1 pr-4\">\n\t\t\t\t\t\t<div class=\"text-sm font-medium\">Théo Balick</div>\n\t\t\t\t\t\t<div class=\"mt-1.5 flex gap-3\">\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"text-xs text-foreground/50\">Expenses</div>\n\t\t\t\t\t\t\t\t<div class=\"text-sm font-semibold\">$32.65k</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"h-7 w-px bg-border\"></div>\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"text-xs text-foreground/50\">Income</div>\n\t\t\t\t\t\t\t\t<div class=\"text-sm font-semibold\">$2.65k</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n{/snippet}\n",
