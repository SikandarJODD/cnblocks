{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "footer-two",
	"type": "registry:block",
	"description": "Dusk multi-column footer with AI platform links",
	"registryDependencies": [
		"./button.json",
		"./logo.json",
		"./svgs.json"
