			"content": "<script lang=\"ts\">\n\timport X from \"@lucide/svelte/icons/x\";\n\timport Logo from \"#lib/components/web/Logo.svelte\";\n\timport { Button } from \"#lib/components/ui/dusk/button/index.js\";\n\timport { watch } from \"runed\";\n\n\tconst menuItems = [\n\t\t{ name: \"Programs\", href: \"/\" },\n\t\t{ name: \"Coaches\", href: \"/\" },\n\t\t{ name: \"Pricing\", href: \"/\" },\n\t\t{ name: \"Company\", href: \"/\" },\n\t];\n\n\tlet menuState = $state(false);\n\tlet menuButton: HTMLButtonElement;\n\tconst id = $props.id();\n\tconst menuId = `${id}-menu`;\n\n\twatch(\n\t\t() => menuState,\n\t\t(isOpen) => {\n\t\t\tif (!isOpen) return;\n\n\t\t\tconst mediaQuery = window.matchMedia(\"(max-width: 1023px)\");\n\t\t\tconst updateOverflow = () => {\n\t\t\t\tdocument.documentElement.classList.toggle(\"overflow-hidden\", mediaQuery.matches);\n\t\t\t};\n\n\t\t\tupdateOverflow();\n\t\t\tmediaQuery.addEventListener(\"change\", updateOverflow);\n\n\t\t\treturn () => {\n\t\t\t\tmediaQuery.removeEventListener(\"change\", updateOverflow);\n\t\t\t\tdocument.documentElement.classList.remove(\"overflow-hidden\");\n\t\t\t};\n\t\t}\n\t);\n\n\tfunction closeMenu() {\n\t\tmenuState = false;\n\t}\n\n\tfunction handleKeydown(event: KeyboardEvent) {\n\t\tif (event.key === \"Escape\" && menuState) {\n\t\t\tcloseMenu();\n\t\t\tmenuButton.focus();\n\t\t}\n\t}\n</script>\n\n<svelte:window onkeydown={handleKeydown} />\n\n<header>\n\t<nav\n\t\tdata-state={menuState && \"active\"}\n\t\tclass=\"fixed top-0 z-50 w-full px-2 max-lg:data-[state=active]:bottom-0 max-lg:data-[state=active]:bg-background\"\n\t>\n\t\t<div class=\"mx-auto mt-2 max-w-7xl px-6 transition-all duration-300\">\n\t\t\t<div\n\t\t\t\tclass=\"relative flex flex-wrap items-center justify-between gap-6 py-3 lg:gap-0 lg:py-4\"\n\t\t\t>\n\t\t\t\t<div class=\"flex w-full justify-between lg:w-auto\">\n\t\t\t\t\t<a href=\"/\" aria-label=\"Home\" class=\"flex items-center space-x-2\">\n\t\t\t\t\t\t<Logo />\n\t\t\t\t\t</a>\n\n\t\t\t\t\t<button\n\t\t\t\t\t\tbind:this={menuButton}\n\t\t\t\t\t\tonclick={() => (menuState = !menuState)}\n\t\t\t\t\t\taria-label={menuState ? \"Close Menu\" : \"Open Menu\"}\n\t\t\t\t\t\taria-controls={menuId}\n\t\t\t\t\t\taria-expanded={menuState}\n\t\t\t\t\t\tclass=\"relative z-20 block cursor-pointer after:absolute after:-inset-4 lg:hidden\"\n\t\t\t\t\t>\n\t\t\t\t\t\t<span\n\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\tclass=\"m-auto flex size-4.5 flex-col items-center justify-center gap-[7px] transition-[transform,opacity] duration-200 in-data-[state=active]:scale-0 in-data-[state=active]:rotate-180 in-data-[state=active]:opacity-0 motion-reduce:transition-none\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t<span class=\"h-0.5 w-full rounded-full bg-foreground\"></span>\n\t\t\t\t\t\t\t<span class=\"h-0.5 w-full rounded-full bg-foreground\"></span>\n\t\t\t\t\t\t</span>\n\n\t\t\t\t\t\t<X\n\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\tclass=\"absolute inset-0 m-auto size-6 -translate-x-[3px] scale-0 -rotate-180 opacity-0 transition-[transform,opacity] duration-200 in-data-[state=active]:scale-100 in-data-[state=active]:rotate-0 in-data-[state=active]:opacity-100 motion-reduce:transition-none\"\n\t\t\t\t\t\t/>\n\t\t\t\t\t</button>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"absolute inset-0 m-auto size-fit max-lg:hidden\">\n\t\t\t\t\t<ul class=\"flex gap-8 text-sm\">\n\t\t\t\t\t\t{#each menuItems as item}\n\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t<a\n\t\t\t\t\t\t\t\t\thref={item.href}\n\t\t\t\t\t\t\t\t\tclass=\"block text-muted-foreground transition-colors duration-150 hover:text-accent-foreground\"\n\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t<span>{item.name}</span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t{/each}\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\n\t\t\t\t<div\n\t\t\t\t\tid={menuId}\n\t\t\t\t\tclass=\"mb-6 hidden w-full flex-wrap items-center justify-end in-data-[state=active]:block max-lg:space-y-8 md:flex-nowrap lg:m-0 lg:flex lg:w-fit lg:gap-6 lg:in-data-[state=active]:flex\"\n\t\t\t\t>\n\t\t\t\t\t<div class=\"lg:hidden\">\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t{#each menuItems as item}\n\t\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t\t<a\n\t\t\t\t\t\t\t\t\t\thref={item.href}\n\t\t\t\t\t\t\t\t\t\tonclick={closeMenu}\n\t\t\t\t\t\t\t\t\t\tclass=\"block py-3 text-2xl font-medium text-foreground\"\n\t\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t\t<span>{item.name}</span>\n\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div\n\t\t\t\t\t\tclass=\"flex w-full flex-col space-y-3 sm:flex-row sm:gap-3 sm:space-y-0 md:w-fit\"\n\t\t\t\t\t>\n\t\t\t\t\t\t<Button href=\"/\" size=\"sm\" variant=\"outline\" onclick={closeMenu}\n\t\t\t\t\t\t\t>Login</Button\n\t\t\t\t\t\t>\n\t\t\t\t\t\t<Button href=\"/\" size=\"sm\" onclick={closeMenu}>Start Training</Button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</nav>\n</header>\n\n<div\n\taria-hidden=\"true\"\n\tclass=\"pointer-events-none fixed inset-x-0 top-0 z-30 h-20 bg-background/50 mask-b-from-10% backdrop-blur-sm\"\n></div>\n",
			"type": "registry:component",
			"target": "dusk/hero/three/header.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Beacon, Bolt, Hulu, Spotify, SupabaseFull, VercelFull } from \"#lib/svgs/index.js\";\n</script>\n\n<div\n\tclass=\"relative mt-24 flex flex-wrap items-center justify-center gap-8 **:fill-muted-foreground md:gap-x-16\"\n>\n\t<Bolt class=\"h-[22px] w-[54px]\" />\n\t<VercelFull class=\"h-[22px] w-[84px]\" />\n\t<SupabaseFull class=\"h-6 w-auto\" />\n\t<Hulu class=\"h-[18px] w-14\" />\n\t<Spotify class=\"h-[26px] w-[84px]\" />\n\t<Beacon class=\"h-6 w-20\" />\n</div>\n",
