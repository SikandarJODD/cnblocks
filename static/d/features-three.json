m] bg-white p-3 shadow-lg ring shadow-black/15 ring-black/10\"\n\t\t>\n\t\t\t<div class=\"relative\">\n\t\t\t\t<img\n\t\t\t\t\tsrc={profileImage}\n\t\t\t\t\talt=\"\"\n\t\t\t\t\twidth=\"500\"\n\t\t\t\t\theight=\"500\"\n\t\t\t\t\tclass=\"absolute inset-0 top-0 size-full object-cover opacity-45 blur-xl contrast-200\"\n\t\t\t\t\tloading=\"lazy\"\n\t\t\t\t\tdecoding=\"async\"\n\t\t\t\t/>\n\t\t\t\t<div\n\t\t\t\t\tclass=\"relative rounded-[2.25rem] bg-white p-2 shadow-xl ring shadow-black/6.5 ring-black/10\"\n\t\t\t\t>\n\t\t\t\t\t<div class=\"flex gap-2\">\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\tclass=\"relative size-18 overflow-hidden rounded-[1.75rem] shadow-md before:absolute before:inset-0 before:rounded-[1.75rem] before:border before:border-black/20\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t<img\n\t\t\t\t\t\t\t\tsrc={profileImage}\n\t\t\t\t\t\t\t\talt=\"\"\n\t\t\t\t\t\t\t\twidth=\"136\"\n\t\t\t\t\t\t\t\theight=\"136\"\n\t\t\t\t\t\t\t\tloading=\"lazy\"\n\t\t\t\t\t\t\t\tdecoding=\"async\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"py-1 pr-4\">\n\t\t\t\t\t\t\t<div class=\"text-sm font-medium text-black\">Théo Balick</div>\n\t\t\t\t\t\t\t<div class=\"mt-1.5 flex items-center gap-3\">\n\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t<div class=\"text-xs text-black/50\">Expenses</div>\n\t\t\t\t\t\t\t\t\t<div class=\"mt-0.5 text-sm font-semibold text-black\">\n\t\t\t\t\t\t\t\t\t\t$32.65k\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"h-7 w-px bg-border\"></div>\n\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t<div class=\"text-xs text-black/50\">Income</div>\n\t\t\t\t\t\t\t\t\t<div class=\"mt-0.5 text-sm font-semibold text-black\">\n\t\t\t\t\t\t\t\t\t\t$2.65k\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n{/snippet}\n",
